{
  "name": "api",
  "version": "1.0.0",
  "description": "API du guide de cartes Aikaho JJK",
  "license": "ISC",
  "author": "Andyd201",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations up",
    "migrate:down": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations down",
    "migrate:create": "node-pg-migrate create -m migrations -j js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
